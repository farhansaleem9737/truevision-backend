# Copy to .env and fill in. All values are optional — defaults work for local dev.

# ── HTTP server ─────────────────────────────────────────────────────────────
AI_HOST=0.0.0.0
AI_PORT=8001

# Comma-separated allowed origins for CORS. "*" allows everything (dev only).
CORS_ORIGINS=*

# Optional shared secret. When set, the Node aiClient must send the same
# value in the X-API-Key header. Leave blank in dev to disable auth.
AI_API_KEY=

# ── Models ──────────────────────────────────────────────────────────────────
# Override the DistilBERT model directory. Default: Backend/models/truevision_model
# TRUEVISION_MODEL_DIR=/absolute/path/to/truevision_model

# Override the FAQ knowledge-base path. Default: services/ai/data/faqs.json
# TRUEVISION_FAQ_PATH=/absolute/path/to/faqs.json

# Sentence-transformer model used by /chatbot. Default is the small MiniLM
# which downloads on first request (~80 MB).
# CHATBOT_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Class labels for the DistilBERT classifier. Order MUST match the indices
# the model was trained on (class 0, class 1, …). Your config.json carries
# generic LABEL_0..LABEL_3 placeholders, so we map them here.
TRUEVISION_LABELS=Educational,Professional,News,Entertainment

# ── Recommendation tuning ───────────────────────────────────────────────────
# Multiplier applied to the (educational_score × category_boost) term.
# Higher = more aggressive educational/professional bias.
EDU_WEIGHT=1.5

# ── Moderation tuning ───────────────────────────────────────────────────────
# Detections below this NudeNet score are discarded as noise.
NUDENET_THRESHOLD=0.30
MODERATION_FRAMES=5
FETCH_TIMEOUT=20
